# ── Cache de assets — Allaser ──────────────────────────────────────────────
# Contexto: o servidor LiteSpeed da Napoleon envia Cache-Control de até 1 ano
# para CSS/JS, e o Cloudflare (que fica na frente do domínio) respeita esse
# header da origem. Resultado: alterações em components.js / shared.css / etc.
# demoravam ~30 dias para aparecer no ar, mesmo com o deploy correto.
#
# Solução: forçar REVALIDAÇÃO nesses arquivos. O navegador e o Cloudflare passam
# a perguntar à origem "esse arquivo mudou?" a cada requisição e só rebaixam se
# mudou (resposta 304 — leve). Assim os deploys aparecem na hora, SEM precisar
# versionar arquivos manualmente (?v=1, ?v=2…). Vale também para .json — ex.: o
# credenciados.json editado pelo painel admin, que de outra forma ficaria preso
# no cache após cada edição.
#
# Os HTML já vêm com max-age=0 (sempre frescos), então não precisam de regra.

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>
</IfModule>

# Desliga o mod_expires para esses tipos (era ele que setava o max-age longo).
<IfModule mod_expires.c>
  <FilesMatch "\.(css|js|json)$">
    ExpiresActive Off
  </FilesMatch>
</IfModule>

# ── Cache LONGO pra imagens, videos e fontes (1 ano) ────────────────────────
# Assets que raramente mudam. Melhora Lighthouse "efficient cache lifetime" e
# reduz banda em visitas repetidas. Se precisar trocar, renomear o arquivo
# (foto-v2.webp) ou passar ?v=X.
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico|mp4|webm|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico|mp4|webm|woff2|woff|ttf)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>

# ── URLs limpas (sem .html) — Allaser ──────────────────────────────────────
# Contexto: site é HTML estático puro, então o Apache serve /blog.html pelo nome
# literal. Regras abaixo:
#   1. Se alguém acessa /blog.html, redireciona 301 pra /blog (preserva SEO,
#      links antigos indexados continuam funcionando).
#   2. Se alguém acessa /blog (sem extensão), serve /blog.html internamente
#      sem mudar a URL na barra do navegador.
#   3. Preserva query strings (?cat=x) e âncoras (#section).
#
# Ordem importa: o redirect 301 vem ANTES do rewrite interno, senão dava loop.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) /qualquer-coisa.html  →  /qualquer-coisa  (301, mantém ?query)
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html([\s?]|$) [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 2) Páginas ainda não criadas — redireciona pra /sobre (Quem Somos).
  # Cai antes da regra 3 pra 301 não virar rewrite interno em .html inexistente.
  RewriteRule ^professores/?$ /sobre [R=301,L]
  RewriteRule ^faq/?$         /sobre [R=301,L]
  RewriteRule ^contato/?$     /sobre [R=301,L]

  # 3) /qualquer-coisa  →  serve /qualquer-coisa.html (rewrite interno, URL fica limpa)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>
